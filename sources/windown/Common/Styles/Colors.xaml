<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- BẢNG MÃ MÀU RIÊNG BIỆT (COLOR PALETTE / PRIMITIVES) CHO TOÀN BỘ HỆ THỐNG   -->
    <!-- Chuyên quản lý mã màu nguyên thủy (Hex), không phụ thuộc vào Theme hay Style -->
    <!-- ========================================================================= -->

    <!-- 1. BẢNG MÃ MÀU VÀNG KIM THƯƠNG HIỆU (GOLD BRAND PALETTE) -->
    <Color x:Key="ColorGoldPrimary">#D4AF37</Color>         <!-- Vàng kim chuẩn 18k/24k (Metallic Gold) -->
    <Color x:Key="ColorGoldLight">#F5E8C7</Color>           <!-- Vàng nhạt trang nhã -->
    <Color x:Key="ColorGoldHover">#E2BD44</Color>           <!-- Vàng kim khi rê chuột (Hover) -->
    <Color x:Key="ColorGoldPressed">#B59227</Color>         <!-- Vàng kim sẫm khi nhấn giữ (Pressed) -->
    <Color x:Key="ColorGoldDark">#8C6D1F</Color>            <!-- Vàng kim đậm (Dành cho nền sáng tương phản) -->
    <Color x:Key="ColorRoseGold">#B76E79</Color>            <!-- Vàng hồng cao cấp -->
    <Color x:Key="ColorPlatinum">#E5E4E2</Color>            <!-- Bạch kim sang trọng -->

    <!-- 2. BẢNG MÃ MÀU TRẠNG THÁI HỆ THỐNG (SYSTEM STATUS PALETTE) -->
    <Color x:Key="ColorStatusSuccess">#107C41</Color>       <!-- Xanh lá: Hoạt động tốt, Đã kết nối máy chủ/cân -->
    <Color x:Key="ColorStatusWarning">#F7630C</Color>       <!-- Cam: Cảnh báo, Biên lai treo, Chờ thanh toán -->
    <Color x:Key="ColorStatusDanger">#E81123</Color>        <!-- Đỏ chuẩn Windows: Lỗi, Cảnh báo huỷ, Đóng cửa sổ -->
    <Color x:Key="ColorStatusDangerPressed">#BA141A</Color> <!-- Đỏ sẫm khi nhấn giữ nút Đóng cửa sổ -->
    <Color x:Key="ColorStatusInfo">#0078D4</Color>          <!-- Xanh dương: Thông báo, Hướng dẫn nghiệp vụ -->

    <!-- 3. BẢNG MÃ MÀU TITLEBAR & WINDOW CHROME -->
    <Color x:Key="ColorTitleBarHoverDark">#26FFFFFF</Color>       <!-- Độ trong suốt 15% trắng (Dark mode) -->
    <Color x:Key="ColorTitleBarPressedDark">#40FFFFFF</Color>     <!-- Độ trong suốt 25% trắng (Dark mode) -->
    <Color x:Key="ColorTitleBarHoverLight">#1A000000</Color>      <!-- Độ trong suốt 10% đen (Light mode) -->
    <Color x:Key="ColorTitleBarPressedLight">#2E000000</Color>    <!-- Độ trong suốt 18% đen (Light mode) -->

    <!-- 4. BẢNG MÃ MÀU BỀ MẶT VÀ NỀN (SURFACE & BACKGROUND PALETTE) -->
    <!-- Nhóm Dark (Nền tối Mica) -->
    <Color x:Key="ColorSurfaceDark">#1E1E1E</Color>
    <Color x:Key="ColorSurfaceDarkCard">#2B2B2B</Color>
    <Color x:Key="ColorBorderDark">#383838</Color>
    <Color x:Key="ColorTextDarkPrimary">#FFFFFF</Color>
    <Color x:Key="ColorTextDarkSecondary">#CCCCCC</Color>
    <Color x:Key="ColorTextDarkMuted">#888888</Color>

    <!-- Nhóm Light (Nền sáng Mica) -->
    <Color x:Key="ColorSurfaceLight">#F9F9F9</Color>
    <Color x:Key="ColorSurfaceLightCard">#FFFFFF</Color>
    <Color x:Key="ColorBorderLight">#E5E5E5</Color>
    <Color x:Key="ColorTextLightPrimary">#1A1A1A</Color>
    <Color x:Key="ColorTextLightSecondary">#5C5C5C</Color>
    <Color x:Key="ColorTextLightMuted">#8A8A8A</Color>

</ResourceDictionary>
